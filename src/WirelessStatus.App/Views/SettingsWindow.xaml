<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WirelessStatus.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WirelessStatus.App.ViewModels"
    Title="WirelessStatus settings">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="16,12" />
            </Style>
            <Style x:Key="SectionHeaderStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,20,0,6" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="48" Padding="16,0">
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="WirelessStatus settings" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,0,24,24" Spacing="4">
                <TextBlock
                    Margin="0,0,0,4"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Settings" />

                <!-- General -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="General" />

                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ThresholdLabel" Text="Low battery warning" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="Notify when a device is at or below this level (%)"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <NumberBox
                            Grid.Column="1"
                            MinWidth="120"
                            VerticalAlignment="Center"
                            AutomationProperties.LabeledBy="{x:Bind ThresholdLabel}"
                            Maximum="{x:Bind vm:SettingsViewModel.MaxThreshold}"
                            Minimum="{x:Bind vm:SettingsViewModel.MinThreshold}"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            Value="{x:Bind ViewModel.Threshold, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="IntervalLabel"
                            VerticalAlignment="Center"
                            Text="Check battery levels every" />
                        <ComboBox
                            Grid.Column="1"
                            MinWidth="140"
                            AutomationProperties.LabeledBy="{x:Bind IntervalLabel}"
                            ItemsSource="{x:Bind ViewModel.PollIntervalOptions}"
                            SelectedIndex="{x:Bind ViewModel.PollIntervalIndex, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="AutostartLabel"
                            VerticalAlignment="Center"
                            Text="Start with Windows" />
                        <ToggleSwitch
                            Grid.Column="1"
                            MinWidth="0"
                            AutomationProperties.LabeledBy="{x:Bind AutostartLabel}"
                            IsOn="{x:Bind ViewModel.StartWithWindows, Mode=TwoWay}"
                            OffContent=""
                            OnContent="" />
                    </Grid>
                </Border>

                <!-- Devices -->
                <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="Devices" />

                <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Devices}">
                    <ItemsControl.ItemContainerTransitions>
                        <TransitionCollection />
                    </ItemsControl.ItemContainerTransitions>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceSettingsViewModel">
                            <Border Margin="0,0,0,4" Style="{StaticResource CardStyle}">
                                <Grid ColumnSpacing="16" RowSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <FontIcon
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Glyph="{x:Bind Glyph}" />
                                    <TextBox
                                        Grid.Column="1"
                                        AutomationProperties.Name="{x:Bind OriginalName}"
                                        PlaceholderText="{x:Bind OriginalName}"
                                        Text="{x:Bind DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ToolTipService.ToolTip="Name shown in the list. Leave empty to use the device's own name." />

                                    <StackPanel
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="24">
                                        <ToggleSwitch Header="Show in list" IsOn="{x:Bind ShowInList, Mode=TwoWay}" />
                                        <ToggleSwitch Header="Low battery notifications" IsOn="{x:Bind NotificationsEnabled, Mode=TwoWay}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No devices seen yet."
                    Visibility="{x:Bind ViewModel.HasNoDevices}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WirelessStatus.App.Views.PopupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:WirelessStatus.App.ViewModels"
    Title="WirelessStatus">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Padding="16,12,16,12" RowSpacing="8" KeyDown="Root_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <TextBlock
                VerticalAlignment="Center"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                Text="Wireless devices" />
            <Button
                x:Name="RefreshButton"
                HorizontalAlignment="Right"
                Padding="8"
                AutomationProperties.Name="Refresh"
                Background="Transparent"
                BorderThickness="0"
                Click="RefreshButton_Click"
                ToolTipService.ToolTip="Refresh">
                <FontIcon FontSize="14" Glyph="&#xE72C;" />
            </Button>
        </Grid>

        <!-- Device list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl IsTabStop="False" ItemsSource="{x:Bind ViewModel.Devices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:DeviceViewModel">
                            <Grid
                                Padding="0,8"
                                AutomationProperties.Name="{x:Bind AutomationName, Mode=OneWay}"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Glyph="{x:Bind Glyph, Mode=OneWay}"
                                    Opacity="{x:Bind ContentOpacity, Mode=OneWay}" />

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Opacity="{x:Bind ContentOpacity, Mode=OneWay}"
                                    Spacing="6">
                                    <TextBlock Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                                    <ProgressBar
                                        Maximum="100"
                                        ShowError="{x:Bind IsLow, Mode=OneWay}"
                                        Visibility="{x:Bind IsAvailable, Mode=OneWay}"
                                        Value="{x:Bind Level, Mode=OneWay}" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="4">
                                    <FontIcon
                                        FontSize="12"
                                        Glyph="&#xE945;"
                                        ToolTipService.ToolTip="Charging"
                                        Visibility="{x:Bind IsCharging, Mode=OneWay}" />
                                    <TextBlock
                                        MinWidth="36"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{x:Bind StatusText, Mode=OneWay}"
                                        TextAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    Margin="0,8"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="No wireless devices found."
                    Visibility="{x:Bind ViewModel.HasNoDevices, Mode=OneWay}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.LastUpdatedText, Mode=OneWay}" />
            <Button
                HorizontalAlignment="Right"
                Padding="8"
                AutomationProperties.Name="Settings"
                Background="Transparent"
                BorderThickness="0"
                Click="SettingsButton_Click"
                ToolTipService.ToolTip="Settings">
                <FontIcon FontSize="14" Glyph="&#xE713;" />
            </Button>
        </Grid>
    </Grid>
</Window>
